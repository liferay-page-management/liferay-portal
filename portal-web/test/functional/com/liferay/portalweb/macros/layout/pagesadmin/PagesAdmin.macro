definition {

	macro viewPageStatus {
		if (!(isSet(index))) {
			var index = "1";
		}

		AssertTextEquals(
			index = "${index}",
			key_itemName = "${pageName}",
			locator1 = "SitePages#LIST_GROUP_ITEM_PAGE_STATUS",
			value1 = "${status}");
	}

	macro viewPageType {
		AssertElementPresent(
			key_pageName = "${pageName}",
			key_pageType = "${pageType}",
			locator1 = "SitePages#LIST_GROUP_ITEM_PAGE_TYPE");
	}

}